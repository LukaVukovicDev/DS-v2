<Window x:Class="CoworkingApp.GUI.Dialogs.MembershipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tip članstva" Height="340" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Naziv" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Grid.Column="1" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" Text="Cena" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="PriceTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="2" Text="Trajanje (dani)" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="DurationTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="3" Text="Max sati mesečno" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxHoursTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>
            <CheckBox x:Name="IncludesRoomsCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Uključuje sale za sastanke" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="5" Text="Sati za sale mesečno" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBox x:Name="MeetingHoursTextBox" Grid.Row="5" Grid.Column="1"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Sačuvaj" Width="110" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Otkaži" Width="110" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
