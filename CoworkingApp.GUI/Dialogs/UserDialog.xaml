<Window x:Class="CoworkingApp.GUI.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Korisnik" Height="430" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ime" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="FirstNameTextBox" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Text="Prezime" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="LastNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Text="Email" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="EmailTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Text="Telefon" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBox x:Name="PhoneTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="Tip članstva" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <ComboBox x:Name="MembershipComboBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" DisplayMemberPath="Name"/>

            <TextBlock Grid.Row="5" Text="Početak" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDatePicker" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="6" Text="Istek" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDatePicker" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="7" Text="Status" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="StatusComboBox" Grid.Row="7" Grid.Column="1"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Sačuvaj" Width="110" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Otkaži" Width="110" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
