<Window x:Class="CoworkingApp.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coworking Manager" Height="860" Width="1480" WindowStartupLocation="CenterScreen">
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#1F3A5F" Padding="18">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock x:Name="BrandNameTextBlock" Foreground="White" FontSize="28" FontWeight="Bold" Text="Coworking"/>
                    <TextBlock Foreground="#DDE8F7" FontSize="13" Text="Administracija korisnika, lokacija, resursa i rezervacija"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshAllButton" Click="RefreshAllButton_Click" Margin="0,0,10,0" Padding="16,8" Content="Osveži sve"/>
                    <Button x:Name="AboutButton" Click="AboutButton_Click" Padding="16,8" Content="Info"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16">
            <TabItem Header="Korisnici">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <TextBox x:Name="UserSearchTextBox" Width="220" Height="30" Margin="0,0,8,8" VerticalContentAlignment="Center" TextChanged="UserFilterChanged"/>
                        <ComboBox x:Name="UserLocationFilterComboBox" Width="200" Height="30" Margin="0,0,8,8" SelectionChanged="UserFilterChanged" DisplayMemberPath="Name"/>
                        <ComboBox x:Name="UserMembershipFilterComboBox" Width="200" Height="30" Margin="0,0,8,8" SelectionChanged="UserFilterChanged" DisplayMemberPath="Name"/>
                        <ComboBox x:Name="UserStatusFilterComboBox" Width="160" Height="30" Margin="0,0,8,8" SelectionChanged="UserFilterChanged"/>
                        <Button Content="Reset filtera" Width="120" Height="30" Click="ResetUserFilters_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="UsersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Ime" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="Članstvo" Binding="{Binding MembershipType.Name}" Width="*"/>
                            <DataGridTextColumn Header="Početak" Binding="{Binding MembershipStartDate, StringFormat=d}" Width="*"/>
                            <DataGridTextColumn Header="Istek" Binding="{Binding MembershipEndDate, StringFormat=d}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Dodaj" Width="110" Margin="0,0,8,0" Click="AddUserButton_Click"/>
                        <Button Content="Izmeni" Width="110" Margin="0,0,8,0" Click="EditUserButton_Click"/>
                        <Button Content="Obriši" Width="110" Click="DeleteUserButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Lokacije">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="LocationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="LocationsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Adresa" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Grad" Binding="{Binding City}" Width="*"/>
                            <DataGridTextColumn Header="Radno vreme" Binding="{Binding WorkingHours}" Width="*"/>
                            <DataGridTextColumn Header="Kapacitet" Binding="{Binding MaxCapacity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="16" Background="White" BorderBrush="#D7E0EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Statistika lokacije" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                            <TextBlock x:Name="LocationStatsName" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="LocationStatsTotalResources" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LocationStatsReserved" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LocationStatsOccupancy" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LocationStatsDescription" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Grid.ColumnSpan="2">
                        <Button Content="Dodaj" Width="110" Margin="0,0,8,0" Click="AddLocationButton_Click"/>
                        <Button Content="Izmeni" Width="110" Margin="0,0,8,0" Click="EditLocationButton_Click"/>
                        <Button Content="Obriši" Width="110" Click="DeleteLocationButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Tipovi članstva">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="MembershipsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Price}" Width="*"/>
                            <DataGridTextColumn Header="Trajanje (dani)" Binding="{Binding DurationDays}" Width="*"/>
                            <DataGridTextColumn Header="Max sati mesečno" Binding="{Binding MaxReservationHoursPerMonth}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Sale" Binding="{Binding IncludesMeetingRooms}" Width="*"/>
                            <DataGridTextColumn Header="Sati za sale" Binding="{Binding MeetingRoomHoursPerMonth}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Dodaj" Width="110" Margin="0,0,8,0" Click="AddMembershipButton_Click"/>
                        <Button Content="Izmeni" Width="110" Margin="0,0,8,0" Click="EditMembershipButton_Click"/>
                        <Button Content="Obriši" Width="110" Click="DeleteMembershipButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Resursi">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <ComboBox x:Name="ResourcesLocationComboBox" Width="220" Height="30" Margin="0,0,8,8" DisplayMemberPath="Name" SelectionChanged="ResourcesFilterChanged"/>
                        <ComboBox x:Name="ResourcesTypeComboBox" Width="180" Height="30" Margin="0,0,8,8" SelectionChanged="ResourcesFilterChanged"/>
                    </WrapPanel>

                    <DataGrid x:Name="ResourcesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Detalji" Binding="{Binding Details}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Dostupan" Binding="{Binding IsAvailable}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Dodaj" Width="110" Margin="0,0,8,0" Click="AddResourceButton_Click"/>
                        <Button Content="Izmeni" Width="110" Margin="0,0,8,0" Click="EditResourceButton_Click"/>
                        <Button Content="Dostupnost" Width="110" Margin="0,0,8,0" Click="ToggleAvailabilityButton_Click"/>
                        <Button Content="Obriši" Width="110" Click="DeleteResourceButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Rezervacije">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,12">
                        <ComboBox x:Name="ReservationUserComboBox" Width="250" Height="30" Margin="0,0,8,8" DisplayMemberPath="FullName" SelectionChanged="ReservationFilterChanged"/>
                        <ComboBox x:Name="ReservationLocationComboBox" Width="220" Height="30" Margin="0,0,8,8" DisplayMemberPath="Name" SelectionChanged="ReservationFilterChanged"/>
                        <DatePicker x:Name="ReservationDayPicker" Width="160" Height="30" Margin="0,0,8,8" SelectedDateChanged="ReservationFilterChanged"/>
                    </WrapPanel>

                    <GroupBox Grid.Row="1" Header="Rezervacije izabranog korisnika" Margin="0,0,0,10">
                        <DataGrid x:Name="UserReservationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Korisnik" Binding="{Binding UserDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Resurs" Binding="{Binding ResourceDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Početak" Binding="{Binding StartDateTime, StringFormat=g}" Width="*"/>
                                <DataGridTextColumn Header="Kraj" Binding="{Binding EndDateTime, StringFormat=g}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="Rezervacije za dan i lokaciju">
                        <DataGrid x:Name="DayReservationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Korisnik" Binding="{Binding UserDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Resurs" Binding="{Binding ResourceDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Početak" Binding="{Binding StartDateTime, StringFormat=g}" Width="*"/>
                                <DataGridTextColumn Header="Kraj" Binding="{Binding EndDateTime, StringFormat=g}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Nova rezervacija" Width="130" Margin="0,0,8,0" Click="AddReservationButton_Click"/>
                        <Button Content="Izmeni" Width="110" Margin="0,0,8,0" Click="EditReservationButton_Click"/>
                        <Button Content="Otkaži" Width="110" Click="CancelReservationButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem Header="Izveštaji / CSV">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Od:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="ReportFromDatePicker" Width="160" Height="30" Margin="0,0,12,8"/>
                            <TextBlock Text="Do:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="ReportToDatePicker" Width="160" Height="30" Margin="0,0,12,8"/>
                            <Button Content="Prikaži pregled" Width="130" Height="30" Margin="0,0,8,8" Click="PreviewReportButton_Click"/>
                            <Button Content="Izvezi CSV" Width="120" Height="30" Margin="0,0,8,8" Click="ExportCsvButton_Click"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Automatski eksport:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ReportIntervalComboBox" Width="140" Height="30" Margin="0,0,12,8"/>
                            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ReportFolderTextBox" Width="360" Height="30" Margin="0,0,12,8" VerticalContentAlignment="Center"/>
                            <Button Content="Pokreni auto eksport" Width="150" Height="30" Margin="0,0,8,8" Click="StartAutoReportButton_Click"/>
                            <Button Content="Zaustavi" Width="110" Height="30" Margin="0,0,8,8" Click="StopAutoReportButton_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="#D7E0EA" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ovaj izveštaj prikazuje korišćenje resursa po korisniku za izabrani period." FontWeight="SemiBold"/>
                            <TextBlock x:Name="ReportStatusTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#36506B"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ReportsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Korisnik" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*"/>
                            <DataGridTextColumn Header="Članstvo" Binding="{Binding MembershipTypeName}" Width="*"/>
                            <DataGridTextColumn Header="Broj rezervacija" Binding="{Binding TotalReservations}" Width="*"/>
                            <DataGridTextColumn Header="Ukupno sati" Binding="{Binding TotalHours, StringFormat={}{0:0.##}}" Width="*"/>
                            <DataGridTextColumn Header="Jedinstveni resursi" Binding="{Binding UniqueResources}" Width="*"/>
                            <DataGridTextColumn Header="Lokacije" Binding="{Binding UniqueLocations}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Background="#EEF3F8" Padding="10">
            <TextBlock Text="Napomena: GUI koristi CoworkingFacade kao jedinu ulaznu tačku prema backend-u, uključujući i CSV izveštaje." Foreground="#3B4B5C"/>
        </Border>
    </Grid>
</Window>
